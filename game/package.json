{
  "name": "the-next-dollar-hd2d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "seller:evaluate": "esbuild scripts/sellerEvaluate.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.tmp/sellerEvaluate.mjs --log-level=warning && node node_modules/.tmp/sellerEvaluate.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/jersey-20": "^5.3.0",
    "@fontsource/overpass": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "@google/genai": "^3.6.1",
    "@xstate/react": "^6.1.0",
    "easystarjs": "^0.4.4",
    "hono": "^4.13.21",
    "motion": "^14.14.0",
    "postprocessing": "^6.39.6",
    "pure-rand": "^8.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "xstate": "^5.33.4",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  }
}
